# Live LLM provider. Comma-separate multiple keys when desired.
OPENAI_API_KEY=
LLM_API_KEYS=
LLM_BASE_URL=https://api.openai.com/v1
EVAL_PIN_MODEL=gpt-4.1-mini

# Optional private-provider adapter. Leave unset for public OpenAI-compatible runs.
VELEN_URL=
VELEN_TENANT=

# Qwen embedding service and model paths.
EMBEDDING_SERVER_URL=http://localhost:9981
QWEN3VL_EMBED_PATH=Qwen/Qwen3-VL-Embedding-2B
QWEN_TOKENIZER_PATH=Qwen/Qwen3-VL-8B-Instruct
ECAPA_MODEL=speechbrain/spkrec-ecapa-voxceleb

# Benchmark roots.
MEMGALLERY_ROOT=./data/Mem-Gallery
DATASET_ROOT=./data/Mem-Gallery
H2HMEM_ROOT=./data/H2HMEM
H2H_SOURCE_ROOT=./data/h2h_source
H2HMEM_CAPTIONS=./data/dense_captions_h2hmem.json
MEMGALLERY_DENSE_CAPTIONS=./data/dense_captions_memgallery.json
LEGACY_MEMGALLERY_FACT_ROOT=./data/memgallery_legacy_facts
VOXPOLYBENCH_HOME=./data/VoxPolyBench
VOXPOLYBENCH_ROOT=./data/VoxPolyBench/cases
VOXPOLY_SPEAKER_ROOT=./data/VoxPolyBench/logs/speaker/online_all_cases_v1

# Runtime outputs.
VOXPOLYMEM_STORAGE_DIR=./artifacts/runtime_storage
FUSION_EVAL_RUNS_DIR=./artifacts/evaluation/memgallery
FACT_ROOT=./artifacts/memory/memgallery_contextual_v1/compatible_views/no_role_metadata

